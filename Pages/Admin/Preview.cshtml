@page
@model PublicSchoolProj.Pages.Admin.PreviewModel

@{
	ViewData["Title"] = "Preview";
}

<div class="user-post">
	<h2>@Model.UserPage.title</h2>
	<p>@Model.UserPage.description</p>
	@foreach (var _page in Model.UserPage.GetBlocks())
	{
		<div class="page-block width_@_page.Width">
			@if (_page.Title != null)
			{
				<h3>
					@_page.Title
				</h3>
			}
			@if (_page.ImagePath != null)
			{
				<div class="picture-holder">
					<img src="~/img/@_page.ImagePath" />
				</div>
			}
			else
			{
				<p>NO PIC</p>
			}
			<p>
				@_page.Text
			</p>
		</div>
	}
</div>

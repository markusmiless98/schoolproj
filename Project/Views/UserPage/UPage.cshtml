@using PublicDatabaseAPI.Models;
@model UserPage
@{
	ViewData["Title"] = "Page";
}

<div class="user-post">
	<h2>@Model.title</h2>
	<p>@Model.description</p>
	@foreach (var _page in Model.GetBlocks())
	{
		<div class="page-block width_@_page.Width">
			@if (_page.ImagePath != null)
			{
				<div class="picture-holder">
					<img src="~/img/@_page.ImagePath" />
				</div>
			}
			<p>
				@_page.Text
			</p>
		</div>
	}
</div>
@using PublicDatabaseAPI.Models
@model UserPage
@{
	ViewData["Title"] = "Page";
}
<div class="user-post">
	<div class="user-page-top">
		<h2>@Model.title</h2>
		<p>@Model.description</p>
	</div>
	@if (Model._listOfLinks == null)
	{
		@foreach (var item in Model.links)
		{
			<div>
				<a href="/@item">@item</a>
			</div>
		}
	}
	else if (Model._listOfLinks.Count > 0)
	{
		@foreach (var item in Model._listOfLinks)
		{
			<div>
				<a href="/@item._link">@item._text</a>
			</div>
		}
	}
	else
	{
		@foreach (var item in Model.links)
		{
			<div>
				<a href="/@item">@item</a>
			</div>
		}
	}
	@if (Model.GetBlocks().Count > 0)
	{
		@foreach (var _page in Model.GetBlocks())
		{
			<div class="page-block width_@_page.Width">
				@if (_page.Title != null)
				{
					<h3>
						@_page.Title
					</h3>
				}
				@if (_page.IsImagePathValid())
				{
					<div class="picture-holder">
						<img src="~/img/@_page.ImagePath" />
					</div>
				}
				else if (_page.ImagePath != null && _page.ImagePath.Length > 1)
				{
					<p>Invalid Pic</p>
				}
				<p>
					@_page.Text
				</p>
				<p>
					Temp; @_page.Id
				</p>
			</div>
		}
	}
</div>
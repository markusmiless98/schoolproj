@page
@inject SignInManager<IdentityUser> SignInManager
@addTagHelper *, ViewComponents
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<div class="text-center">
    @if (SignInManager.IsSignedIn(User))
    {
        <div>
            <a asp-page="./Admin/Index">Go To Admin Page</a>
            @if (Model._pages != null)
            {
                @foreach (var item in Model._pages)
                {
                    <div class="one-row">
                        <p>Go To: </p> <a asp-page="./Admin/Preview?Id=@item.Id">@item.title</a>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <p>Log in</p>
    }
</div>

@page
@using PublicDatabaseAPI.Models
@model PublicSchoolProj.Pages.Admin.EditModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Edit";
    UserPage _prev = await Model.PreviewUserPage();
    bool debuging = true;
}


<h1>Edit</h1>

<h4>UserPage</h4>
<h3>
    <a asp-page="./CSSEdit" asp-route-id="1">Go To Edit CSS</a>
</h3>
<hr />
<p>Page Information;</p>
<div>
    @Model.UserPage.Id
</div>
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="UserPage.Id" />
            <input type="hidden" asp-for="UserPage.userId" />
            <div class="form-group">
                <label asp-for="UserPage.title" class="control-label"></label>
                <input asp-for="UserPage.title" class="form-control" />
                <span asp-validation-for="UserPage.title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UserPage.description" class="control-label"></label>
                <input asp-for="UserPage.description" class="form-control" />
                <span asp-validation-for="UserPage.description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UserPage.views" class="control-label"></label>
                <input asp-for="UserPage.views" class="form-control" />
                <span asp-validation-for="UserPage.views" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="UserPage.links" class="control-label"></label>
                    @if (Model.UserPage.GetLinks().Count > 0)
                {
                    int link_amount = Model.UserPage.GetLinks().Count;
                    @if (link_amount < 3)
                        {
                        <button type="submit" asp-page-handler="link" asp-route-id="@Model.UserPage.Id">Add Link</button>
                        <label>(Max 3)</label>
                    }
                    int link_i = 0;
                    bool can_erase = link_amount > 0;

                    foreach (var item in Model.UserPage.GetLinks())
                        {
                            <div class="one-row">
                            <select asp-for="UserPage.links[link_i]">
                            @foreach (var sub_item in await Model.GetListOfItems())
                            {
                                @if (Model.GetTitleFromLink(item.ToString()) != null)
                                {
                                    if (Model.GetTitleFromLink(item.ToString()) == sub_item.Text)
                                    {
                                        <option value="@sub_item.Value" selected="selected">@sub_item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@sub_item.Value">@sub_item.Text</option>
                                    }
                                }
                                else
                                {
                                    <option value="@sub_item.Value">@sub_item.Text</option>
                                }
                            }
                            </select>
                            @if (can_erase)
                            {
                                <button type="submit" asp-page-handler="LinkDelete" asp-route-id="@Model.UserPage.Id" asp-route-target="@link_i">Delete</button>
                            }
                        </div>
                        link_i++;
                        }
                    }
                else
                {
                    <button type="submit" asp-page-handler="link" asp-route-id="@Model.UserPage.Id">Add Link</button>
                    }
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
    <div class="col-md-6">
        @if (Model.UserPageBlocks.Count < 1)
        {
            <h3>
                This page currently has no blocks in it
            </h3>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" value="@Model.GetNewBlockId()" asp-for="UserPageBlock.Id" />
                <input type="hidden" value="@Model.UserPage.Id" asp-for="UserPageBlock.UserPageId" />
                <input type="hidden" value="1" asp-for="UserPageBlock.Row" />
                <input type="hidden" value="1" asp-for="UserPageBlock.Column" />
                <div class="form-group">
                    <div class="form-group">
                        <label asp-for="UserPageBlock.Title" class="control-label"></label>
                        <input asp-for="UserPageBlock.Title" class="form-control" />
                        <span asp-validation-for="UserPageBlock.Title" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="UserPageBlock.Text" class="control-label"></label>
                        <input asp-for="UserPageBlock.Text" class="form-control" />
                        <span asp-validation-for="UserPageBlock.Text" class="text-danger"></span>
                    </div>
                    <input type="submit" value="Create" asp-page-handler="block" asp-route-id="@Model.UserPage.Id" class="btn btn-primary" />
                </div>
            </form>
        }
        else
        {
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" value="@Model.GetNewBlockId()" asp-for="UserPageBlock.Id" />
                <input type="hidden" value="@Model.UserPage.Id" asp-for="UserPageBlock.UserPageId" />
                <input type="hidden" value="1" asp-for="UserPageBlock.Row" />
                <input type="hidden" value="1" asp-for="UserPageBlock.Column" />
                <div class="form-group">
                    <div class="form-group">
                        <label asp-for="UserPageBlock.Title" class="control-label"></label>
                        <input asp-for="UserPageBlock.Title" class="form-control" />
                        <span asp-validation-for="UserPageBlock.Title" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="UserPageBlock.Text" class="control-label"></label>
                        <input asp-for="UserPageBlock.Text" class="form-control" />
                        <span asp-validation-for="UserPageBlock.Text" class="text-danger"></span>
                    </div>
                    <input type="submit" value="Create" asp-page-handler="block" asp-route-id="@Model.UserPage.Id" class="btn btn-primary" />
                </div>
            </form>
            <hr />
            int i = 0;
            @foreach (var block in Model.UserPageBlocks)
            {
                <div class="border-light">
                    @if (Model.Images != null && debuging)
                    {

                    }
                    else
                    {
                        @if (block.ImagePath == null)
                        {
                            <div class="block-pic one-row">
                                <form method="post" enctype="multipart/form-data">
                                    <input type="file" class="form-control" asp-for="UploadedImage" />
                                    <input asp-page-handler="AddPic"
                                           asp-route-id="@Model.UserPage.Id"
                                           asp-route-target="@i"
                                           id="Submit" type="submit" value="submit" />
                                </form>
                            </div>
                        }
                        else if (block.ImagePath.Length < 2)
                        {
                            <div class="block-pic one-row">
                                <form method="post" enctype="multipart/form-data">
                                    <input type="file" class="form-control" asp-for="UploadedImage" />
                                    <input asp-page-handler="AddPic"
                                           asp-route-id="@Model.UserPage.Id"
                                           asp-route-target="@i"
                                           id="Submit" type="submit" value="submit" />
                                </form>
                                <form method="post">
                                    <input asp-page-handler="RemovePic" asp-route-id="@Model.UserPage.Id" asp-route-target="@i" value="Remove Image" type="submit" />
                                </form>
                            </div>
                        }
                        else if (block.IsImagePathValid())
                        {
                            <div class="form-group one-row">
                                <img src="~/img/@block.ImagePath" class="small-pic-preview" />
                                <form method="post" enctype="multipart/form-data">
                                    <input type="file" class="form-control" asp-for="UploadedImage" />
                                    <input asp-page-handler="AddPic"
                                           asp-route-id="@Model.UserPage.Id"
                                           asp-route-target="@i"
                                           id="Submit" type="submit" value="Replace" />
                                </form>
                                <form method="post">
                                    <input asp-page-handler="RemovePic" asp-route-id="@Model.UserPage.Id" asp-route-target="@i" value="Remove Image" type="submit" />
                                </form>
                            </div>
                        }
                    }
                
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" value="@Model.UserPage" asp-for="UserPage" />
                    <input type="hidden" value="@Model.UserPageBlocks[i].Id" asp-for="UserPageBlock"/>
                    <input type="hidden" value="@block.Id" asp-for="UserPageBlocks" />
                    <input type="hidden" value="@Model.UserPage.Id" asp-for="UserPageBlock.UserPageId" />
                    <div>
                        Row;
                            <input type="number" value="@block.Row" asp-for="UserPageBlock.Row" />
                        </div>
                        <div>
                            Column;
                            <input type="number" value="@block.Column" asp-for="UserPageBlock.Column">
                        </div>
                        @if (Model.Images == null)
                        {
                            <input type="hidden" value="@block.ImagePath" asp-for="UserPageBlock.ImagePath" />
                        }
                        else
                        {
                            <select data-val="true" asp-for="@Model.UserPageBlock.ImagePath">
                                @if (!block.IsImagePathValid())
                                {
                                    <option selected="selected" value="NONE">
                                        None
                                    </option>
                                }
                                else
                                {
                                    <option value="NONE">
                                        None
                                    </option>
                                }
                                @foreach (var sub_item in Model.Images)
                                {
                                    if (block.ImagePath != null)
                                    {
                                        if (block.IsImagePathValid() && block.ImagePath == sub_item.Value)
                                        {
                                            <option selected="selected" value="@sub_item.Value">
                                                @sub_item.Text
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@sub_item.Value">
                                                @sub_item.Text
                                            </option>
                                        }
                                    }
                                    else
                                    {
                                        if (i == 0 && !block.IsImagePathValid())
                                        {
                                            <option value="@sub_item.Value">
                                                @sub_item.Text
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@sub_item.Value">
                                                @sub_item.Text
                                            </option>
                                        }
                                    }
                                }
                            </select>
                        }

                    <div class="form-group">
                        <label asp-for="UserPageBlock.Title" class="control-label"></label>
                        <input asp-for="UserPageBlock.Title" value="@block.Title" class="form-control" />
                        <span asp-validation-for="UserPageBlock.Title" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="UserPageBlock.Text" class="control-label"></label>
                        <input asp-for="UserPageBlock.Text" value="@block.Text" class="form-control" />
                        <span asp-validation-for="UserPageBlock.Text" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        
                        <input type="submit" asp-page-handler="EditBlock"
                            asp-route-id="@Model.UserPage.Id"
                            asp-route-target="@block.Id"
                            value="Update" class="btn btn-primary" />
                    </div>
                    @if (Model.UserPageBlocks.Count > 1)
                    {
                        <div class="form-group">
                            <button type="submit" asp-page-handler="DeleteBlock" asp-route-id="@Model.UserPage.Id" asp-route-target="@i">delete</button>
                        </div>
                    }
                </form>
                </div>
                i++;
            }

        }
    </div>
</div>

<div>
    <a asp-page="/Admin/Index">Back to List</a>
</div>
<br/>
<h4>Preview</h4>
<hr/>
<div class="row">
    @if (Model.UserPage != null)
    {
        <a href="/Admin/Preview?id=@Model.UserPage.Id">Go To Preview</a>
        <partial name="CustomPage" for="@_prev" />
    }
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
